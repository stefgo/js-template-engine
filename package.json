{
    "name": "@stefgo/js-template-engine",
    "version": "1.0.0",
    "description": "JSON templates with {{path}} placeholders, filters, conditions and loops, filled in on the parsed tree",
    "license": "MIT",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stefgo/js-template-engine.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "npm@11.12.1",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
        "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "tsc -p tsconfig.build.json",
        "lint": "tsc --noEmit && eslint src",
        "check:entry-points": "node scripts/check-entry-points.js",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.9.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.69.0",
        "vitest": "^5.0.3"
    }
}
