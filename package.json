{
    "name": "@stefgo/js-template-engine",
    "version": "1.0.0",
    "description": "JSON templates with {{path}} placeholders, filters, conditions and loops, filled in on the parsed tree",
    "license": "MIT",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stefgo/js-template-engine.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "npm@11.12.1",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
        "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "tsc -p tsconfig.build.json",
        "lint": "tsc --noEmit && eslint src",
        "check:entry-points": "node scripts/check-entry-points.js",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "eslint": "^10.9.1",
        "semantic-release": "^25.0.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.69.0",
        "vitest": "^5.0.3"
    },
    "release": {
        "branches": [
            "main",
            {
                "name": "dev",
                "prerelease": "beta"
            }
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/changelog",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": true
                }
            ],
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "package-lock.json",
                        "CHANGELOG.md"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
                }
            ],
            "@semantic-release/github"
        ]
    }
}
