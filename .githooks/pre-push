#!/bin/bash

# Only the two long-lived branches may be pushed; topic branches stay local.
#
# More hangs on that than tidiness: release.yml releases on every push to main or dev
# (dev as a beta prerelease). A topic branch pushed by accident produces none, a dev
# pushed by accident very much does.
current_branch=$(git symbolic-ref --short HEAD)

case "$current_branch" in
    main|dev)
        exit 0
        ;;
    *)
        echo "❌ Push is only allowed from 'main' or 'dev' (current branch: '$current_branch')."
        exit 1
        ;;
esac
